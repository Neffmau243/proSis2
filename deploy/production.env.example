# Generate real files using: python deploy/ops.py init --help
# Keep each environment on its own host, including its runner and subnet.
DEPLOY_PROJECT=ipress_production
DOMAIN=salud.example.org
ACME_EMAIL=devops@example.org
APP_IMAGE=ghcr.io/owner/repository@sha256:REPLACE_WITH_PUBLISHED_DIGEST
MYSQL_IMAGE=mysql:8.4
CADDY_IMAGE=caddy:2-alpine
MYSQL_DATABASE=sistema_salud_ipress
PROXY_SUBNET=172.29.241.0/28
SECRETS_DIR=/etc/ipress/production/secrets
BOOTSTRAP_DIR=/etc/ipress/production/bootstrap
BACKUP_DIR=/var/backups/ipress/production
STATE_DIR=/var/lib/ipress/production
HTTP_PORT=80
HTTPS_PORT=443
WEB_CONCURRENCY=1
# Existing installation: transfer private snapshot separately, then enable:
# IPRESS_BOOTSTRAP_FILE=/bootstrap/arequipa.json.gz
# Snapshot includes existing admin; leave the following blank in that case.
CREATE_ADMIN_USERNAME=
# Optional second backup destination (mounted, encrypted storage, another host).
# Deployment refuses to copy offsite into a child of BACKUP_DIR.
BACKUP_COPY_DIR=
BACKUP_KEEP=14
