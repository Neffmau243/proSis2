# Docker Compose environment template.
#
#   cp .env.docker.example .env.docker
#   # edit .env.docker with real secrets
#   docker compose --env-file .env.docker up -d --build
#
# .env.docker is gitignored. Never commit real secrets.
# Every value below is read from the shell or this file; the image bakes none.

# Required. Unique random value of at least 32 characters. Production mode
# refuses placeholder values, so generate one, for example:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-unique-random-secret-key-of-at-least-32-characters

# MySQL credentials. The stack creates the database and its application user.
# Pin the supported LTS branch; review backup/upgrade steps before changing it.
MYSQL_IMAGE=mysql:8.4
MYSQL_DATABASE=sistema_salud_ipress
MYSQL_USER=ipress_app
MYSQL_PASSWORD=replace-with-a-strong-password
MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password
# Optional explicit volume for a fresh installation while retaining the old one.
# When absent, Compose uses <project>_mysql_data.
# MYSQL_VOLUME_NAME=ipress_mysql_data_clean_20261024

# Optional first-run administrator. Restart preserves an existing active ADMIN;
# it does not reset passwords or promote existing non-admin accounts.
# The password must be exactly eight digits.
# CREATE_ADMIN_USERNAME=admin
# CREATE_ADMIN_PASSWORD=12345678

# Runtime tuning.
APP_PORT=8000
WEB_CONCURRENCY=1
ACCESS_TOKEN_EXPIRE_MINUTES=30
TZ=America/Lima
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
RUN_MIGRATIONS=true
# Private installation snapshot: copy this file separately; it is not in Git.
# Set empty only for a deliberately empty installation using Compose directly.
IPRESS_BOOTSTRAP_FILE=/bootstrap/arequipa-completa-20261024.json.gz
# Only addresses of a trusted reverse proxy; do not use * on a directly exposed app.
FORWARDED_ALLOW_IPS=127.0.0.1
