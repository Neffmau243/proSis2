# Copy this file to .env and replace development values before deployment.
APP_NAME=Sistema de Salud IPRESS API
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false
API_V1_PREFIX=/api/v1

# Alembic migrations use this same MySQL configuration; do not create the
# schema by running the reference SQL file manually.
# Either configure a complete MySQL URL or the MYSQL_* variables below.
# DATABASE_URL=mysql+pymysql://usuario:contrasena@localhost:3306/sistema_salud_ipress?charset=utf8mb4
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=ipress_app
MYSQL_PASSWORD=replace-with-a-strong-password
MYSQL_DATABASE=sistema_salud_ipress
SQLALCHEMY_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=1800

# Generate a unique random value of 32+ characters. This example placeholder
# intentionally prevents a production startup; never commit a real key.
SECRET_KEY=replace-with-a-unique-secret-key-of-at-least-32-characters
JWT_ALGORITHM=HS256
JWT_ISSUER=sistema-salud-ipress
JWT_AUDIENCE=sistema-salud-ipress-api
ACCESS_TOKEN_EXPIRE_MINUTES=30
BCRYPT_ROUNDS=12

# Authentication abuse protection. Failed attempts are retained and audited;
# after the configured threshold, each consecutive lock increases up to the cap.
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
LOGIN_LOCK_BASE_SECONDS=60
LOGIN_LOCK_MAX_SECONDS=3600

# JSON is preferred; a comma-separated list also works.
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Authorization,Content-Type,X-Request-ID

DOCS_URL=/docs
REDOC_URL=/redoc
OPENAPI_URL=/openapi.json

# Single-server deployment. With the SPA already built (`npm run build` from
# frontend/), Uvicorn serves the interface and the API from the same origin and
# CORS is no longer needed. The directory is relative to the repository root.
SERVE_FRONTEND=true
FRONTEND_DIST_DIR=frontend/dist
