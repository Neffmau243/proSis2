# Environment and secrets
.env
.env.docker
.env.*
!.env.example
!.env.*.example
deploy/*.env
deploy/secrets/
*.sql.gz
*.sql.gz.json
docker/bootstrap/*.json.gz
.venv/
venv/

# Patient data and Access backups. Only synthetic fixtures belong in Git.
*.mdb
*.accdb

# Python and tooling caches / coverage
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.hypothesis/
.coverage
coverage.xml
htmlcov/

# Local ETL work products extracted from the SIS origin: the folder is a
# developer-machine tool and is NOT delivered with the repository. Its catalog
# values live baked into Alembic migrations, so versioning it is unnecessary.
etlSis/

# Local work products: coverage reports, audit exports and server logs. The
# curated evidence that belongs to the repository lives under docs/audits/.
output/
tmp/pytest-*/
tmp/*.log
tmp/*.json
tmp/admision-etnia/
tmp/crud-admin-*/
frontend/tmp/
